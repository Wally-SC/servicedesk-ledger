# Copie para .env e ajuste. O .env não vai para o repositório.

# Banco da aplicação
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sdledger
POSTGRES_USER=sdledger
POSTGRES_PASSWORD=troque-isto

# Banco do laboratório de índices: o DDL de verdade roda aqui, nunca no banco da
# aplicação (decisão D12)
LAB_POSTGRES_DB=sdledger_lab

# Fuso usado nas consultas analíticas (decisão D18)
TZ_ANALISE=America/Sao_Paulo

# Laboratório: as rotas que criam e removem índice ficam atrás deste token e podem
# ser desligadas por completo (decisão D15)
LAB_HABILITADO=true
LAB_TOKEN=troque-isto
